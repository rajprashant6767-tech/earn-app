<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ZyloBet | Admin Panel</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background: #030508; color: white; font-family: 'Inter', sans-serif; }
        .card { background: linear-gradient(145deg, #111, #000); border: 1px solid #222; }
    </style>
</head>
<body class="p-4 max-w-2xl mx-auto pb-20">

    <!-- Admin Header -->
    <header class="flex justify-between items-center mb-6 card p-4 rounded-2xl border-orange-500/30">
        <div>
            <h1 class="text-lg font-black text-orange-500 italic">ZyloBet Admin</h1>
            <p class="text-[10px] text-gray-400">Manage User Requests</p>
        </div>
        <div class="bg-red-500/20 border border-red-500/30 text-red-400 text-xs px-3 py-1.5 rounded-xl font-bold">
            <i class="fa-solid fa-shield-halved mr-1"></i> Admin Secure
        </div>
    </header>

    <!-- Navigation Tabs -->
    <div class="grid grid-cols-2 gap-3 mb-6">
        <button onclick="switchTab('deposit')" id="tab-deposit" class="py-3 bg-orange-600 rounded-xl font-bold text-xs shadow-lg transition">
            Deposit Requests
        </button>
        <button onclick="switchTab('withdraw')" id="tab-withdraw" class="py-3 bg-gray-900 border border-gray-800 text-gray-400 rounded-xl font-bold text-xs shadow-lg transition">
            Withdrawal Requests
        </button>
    </div>

    <!-- Requests Container -->
    <div id="requests-container" class="space-y-4">
        <!-- Sample Deposit Request Card -->
        <div class="card p-4 rounded-2xl border border-gray-800 space-y-3">
            <div class="flex justify-between items-center text-xs">
                <span class="text-blue-400 font-bold">@Prashant_User</span>
                <span class="text-gray-400">10 mins ago</span>
            </div>
            <div class="bg-gray-900 p-3 rounded-xl flex justify-between items-center text-xs">
                <div>
                    <p class="text-gray-400">Requested Diamonds:</p>
                    <p class="text-cyan-400 font-black text-sm">500 Diamonds (₹500)</p>
                </div>
                <button onclick="alert('Viewing Screenshot Proof...')" class="bg-gray-800 hover:bg-gray-700 text-white px-3 py-1.5 rounded-lg font-bold text-[10px]">
                    <i class="fa-solid fa-image mr-1"></i> View Proof
                </button>
            </div>
            <div class="grid grid-cols-2 gap-2 pt-1">
                <button onclick="handleAction('approve', this)" class="py-2.5 bg-green-600 hover:bg-green-500 text-white font-bold rounded-xl text-xs transition">
                    APPROVE
                </button>
                <button onclick="handleAction('reject', this)" class="py-2.5 bg-red-600 hover:bg-red-500 text-white font-bold rounded-xl text-xs transition">
                    REJECT
                </button>
            </div>
        </div>
    </div>

    <script>
        function switchTab(tab) {
            const depBtn = document.getElementById('tab-deposit');
            const witBtn = document.getElementById('tab-withdraw');
            
            if(tab === 'deposit') {
                depBtn.className = "py-3 bg-orange-600 rounded-xl font-bold text-xs shadow-lg transition";
                witBtn.className = "py-3 bg-gray-900 border border-gray-800 text-gray-400 rounded-xl font-bold text-xs shadow-lg transition";
                loadDepositRequests();
            } else {
                witBtn.className = "py-3 bg-orange-600 rounded-xl font-bold text-xs shadow-lg transition";
                depBtn.className = "py-3 bg-gray-900 border border-gray-800 text-gray-400 rounded-xl font-bold text-xs shadow-lg transition";
                loadWithdrawRequests();
            }
        }

        function loadDepositRequests() {
            const container = document.getElementById('requests-container');
            container.innerHTML = `
                <div class="card p-4 rounded-2xl border border-gray-800 space-y-3">
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-blue-400 font-bold">@Prashant_User</span>
                        <span class="text-gray-400">10 mins ago</span>
                    </div>
                    <div class="bg-gray-900 p-3 rounded-xl flex justify-between items-center text-xs">
                        <div>
                            <p class="text-gray-400">Requested Diamonds:</p>
                            <p class="text-cyan-400 font-black text-sm">500 Diamonds (₹500)</p>
                        </div>
                        <button onclick="alert('Screenshot Proof loaded.')" class="bg-gray-800 hover:bg-gray-700 text-white px-3 py-1.5 rounded-lg font-bold text-[10px]">
                            <i class="fa-solid fa-image mr-1"></i> View Proof
                        </button>
                    </div>
                    <div class="grid grid-cols-2 gap-2 pt-1">
                        <button onclick="handleAction('approve', this)" class="py-2.5 bg-green-600 hover:bg-green-500 text-white font-bold rounded-xl text-xs transition">APPROVE</button>
                        <button onclick="handleAction('reject', this)" class="py-2.5 bg-red-600 hover:bg-red-500 text-white font-bold rounded-xl text-xs transition">REJECT</button>
                    </div>
                </div>`;
        }

        function loadWithdrawRequests() {
            const container = document.getElementById('requests-container');
            container.innerHTML = `
                <div class="card p-4 rounded-2xl border border-gray-800 space-y-3">
                    <div class="flex justify-between items-center text-xs">
                        <span class="text-blue-400 font-bold">@User_Rahul</span>
                        <span class="text-gray-400">25 mins ago</span>
                    </div>
                    <div class="bg-gray-900 p-3 rounded-xl text-xs space-y-1">
                        <p class="text-gray-400">Method: <span class="text-white font-bold">UPI</span></p>
                        <p class="text-gray-400">Amount: <span class="text-amber-400 font-bold">5,000 Coins (₹50)</span></p>
                    </div>
                    <div class="grid grid-cols-2 gap-2 pt-1">
                        <button onclick="handleAction('approve', this)" class="py-2.5 bg-green-600 hover:bg-green-500 text-white font-bold rounded-xl text-xs transition">APPROVE</button>
                        <button onclick="handleAction('reject', this)" class="py-2.5 bg-red-600 hover:bg-red-500 text-white font-bold rounded-xl text-xs transition">REJECT</button>
                    </div>
                </div>`;
        }

        function handleAction(action, btn) {
            const card = btn.closest('.card');
            if(action === 'approve') {
                alert("Request Approved Successfully! User balance updated.");
            } else {
                alert("Request Rejected.");
            }
            card.style.opacity = '0.3';
            setTimeout(() => card.remove(), 400);
        }
    </script>
</body>
</html>
